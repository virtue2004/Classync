# Copy this file to .env — no secrets to set anymore, since there's no
# login system. Identity is per-device, not per-password.
DATABASE_URL=sqlite:///./academy_share.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
MAX_UPLOAD_BATCH_SIZE_MB=500
MAX_FILES_PER_SHARE=50
INSTANCE_NAME=My Academy
OWNER_SETUP_KEY=replace-with-a-long-random-value

# Must match the --port you actually pass to uvicorn when starting the server.
BACKEND_PORT=8000

# Port the FRONTEND dev/build server runs on (not the backend's own port).
# Used to build the "scan to join" link and QR code — must match vite.config.ts.
FRONTEND_PORT=5500
# Leave blank in production. For Vite development only, use the exact origin:
# CORS_ORIGINS=http://localhost:5500
